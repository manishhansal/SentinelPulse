// =============================================================================
// SentinelPulse — Prisma Schema
// All 22 tables for the market intelligence and news impact engine.
//
// Key design rules:
//   - All timestamps: DateTime @db.Timestamptz (UTC, Req 28.4)
//   - UUIDs:          @id @default(uuid())
//   - Soft enums:     TEXT with application-layer validation (no migrations on extension)
//   - pgvector:       Unsupported("vector(1536)") + HNSW index in migration (Req 18.2)
//   - Composite indexes per Req 28.2
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// =============================================================================
// 1. news_sources
// Canonical registry of all configured news sources.
// =============================================================================
model NewsSource {
  id                String    @id // e.g. "reuters"
  name              String
  tier              Int // 1 or 2
  enabled           Boolean   @default(true)
  baseUrl           String?   @map("base_url")
  sourceReliability Float     @default(1.0) @map("source_reliability")
  failureCounter    Int       @default(0) @map("failure_counter")
  disabledUntil     DateTime? @map("disabled_until") @db.Timestamptz
  adapterVersion    String    @map("adapter_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  articles         NewsArticle[]
  sourceMetrics    NewsSourceMetric[]
  ingestionRuns    NewsIngestionRun[]
  processingErrors NewsProcessingError[]

  @@map("news_sources")
}

// =============================================================================
// 2. news_articles
// Canonical normalised article records — one per unique piece of content.
// =============================================================================
model NewsArticle {
  id                 String   @id @default(uuid()) @db.Uuid
  sourceId           String   @map("source_id")
  externalId         String   @map("external_id")
  canonicalUrl       String   @map("canonical_url")
  title              String
  summary            String?
  content            String?
  author             String?
  language           String // ISO 639-1
  languageConfidence Float    @map("language_confidence")
  publishedAt        DateTime @map("published_at") @db.Timestamptz
  scrapedAt          DateTime @map("scraped_at") @db.Timestamptz
  category           String?
  contentHash        String   @unique @map("content_hash") // SHA-256 hex, 64 chars
  titleHash          String   @unique @map("title_hash") // SHA-256 hex, 64 chars
  contentTruncated   Boolean  @default(false) @map("content_truncated")
  timestampInferred  Boolean  @default(false) @map("timestamp_inferred")
  // FULL_ARTICLE | SUMMARY | HEADLINE_ONLY — actual content depth available
  contentDepth       String   @default("SUMMARY") @map("content_depth")
  // Quality score [0,1] combining depth, timestamp confidence, truncation
  contentQualityScore Float   @default(0.5) @map("content_quality_score")
  duplicateCount     Int      @default(0) @map("duplicate_count")
  clusterId          String?  @map("cluster_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  source            NewsSource             @relation(fields: [sourceId], references: [id])
  cluster           NewsCluster?           @relation(fields: [clusterId], references: [id])
  versions          NewsArticleVersion[]
  entityMentions    NewsEntityMention[]
  assetLinks        NewsAssetLink[]
  sectorLinks       NewsSectorLink[]
  events            NewsEvent[]
  articleEventLinks NewsArticleEventLink[]
  sentiment         NewsSentiment[]
  marketImpacts     NewsMarketImpact[]

  @@unique([sourceId, externalId])
  @@index([publishedAt(sort: Desc)])
  @@index([clusterId])
  @@map("news_articles")
}

// =============================================================================
// 3. news_article_versions
// Immutable snapshot of each content change detected on re-scrape.
// =============================================================================
model NewsArticleVersion {
  id          String   @id @default(uuid()) @db.Uuid
  articleId   String   @map("article_id") @db.Uuid
  contentHash String   @map("content_hash")
  titleHash   String   @map("title_hash")
  version     Int
  capturedAt  DateTime @default(now()) @map("captured_at") @db.Timestamptz

  // Relations
  article NewsArticle @relation(fields: [articleId], references: [id])

  @@index([articleId])
  @@map("news_article_versions")
}

// =============================================================================
// 4. news_clusters
// Group of articles from multiple sources covering the same real-world event.
// consensus_score: (Σ tier weights of distinct tiers) / (Σ all tier weights)
// =============================================================================
model NewsCluster {
  id              String   @id @default(uuid()) @db.Uuid
  canonicalUrl    String   @map("canonical_url")
  headline        String
  sourceCount     Int      @default(1) @map("source_count")
  sourceDiversity Int      @default(1) @map("source_diversity")
  consensusScore  Decimal  @default(0.00) @map("consensus_score") @db.Decimal(4, 2)
  firstSeenAt     DateTime @map("first_seen_at") @db.Timestamptz
  lastUpdatedAt   DateTime @default(now()) @map("last_updated_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  articles NewsArticle[]
  alerts   NewsAlert[]

  @@map("news_clusters")
}

// =============================================================================
// 5. news_events
// Structured market event extracted from one or more articles.
// Idempotency key: (article_id, event_type, actor)
// =============================================================================
model NewsEvent {
  id                String   @id @default(uuid()) @db.Uuid
  articleId         String   @map("article_id") @db.Uuid
  eventType         String   @map("event_type") // MONETARY_POLICY | EARNINGS | ...
  actor             String?
  action            String?
  targetEntities    String[] @map("target_entities")
  quantitativeValue Float?   @map("quantitative_value")
  expectedValue     Float?   @map("expected_value")
  expectedValueSrc  String?  @map("expected_value_src")
  surpriseDirection String?  @map("surprise_direction") // BEAT | MISS | IN_LINE | UNKNOWN
  surpriseScore     Float?   @map("surprise_score")
  surpriseScoreErr  String?  @map("surprise_score_err")
  importance        Float    @default(0)
  confidence        Float
  eventTimestamp    DateTime @map("event_timestamp") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  article           NewsArticle            @relation(fields: [articleId], references: [id])
  articleEventLinks NewsArticleEventLink[]
  sentiment         NewsSentiment[]
  importance_       NewsImportance?
  marketImpacts     NewsMarketImpact[]
  marketReactions   NewsMarketReaction[]
  features          NewsFeature[]
  trainingSamples   NewsTrainingSample[]
  alerts            NewsAlert[]

  @@unique([articleId, eventType, actor])
  @@index([eventTimestamp(sort: Desc)])
  @@map("news_events")
}

// =============================================================================
// 6. news_article_event_links
// Many-to-many join between articles and events.
// =============================================================================
model NewsArticleEventLink {
  articleId String @map("article_id") @db.Uuid
  eventId   String @map("event_id") @db.Uuid

  // Relations
  article NewsArticle @relation(fields: [articleId], references: [id])
  event   NewsEvent   @relation(fields: [eventId], references: [id])

  @@id([articleId, eventId])
  @@map("news_article_event_links")
}

// =============================================================================
// 7. news_entities
// Canonical entity registry — surface form resolved to InstrumentMaster.
// instrumentId is a logical FK to data-service; not enforced in this DB.
// =============================================================================
model NewsEntity {
  id           String   @id @default(uuid()) @db.Uuid
  surfaceForm  String   @map("surface_form")
  entityType   String   @map("entity_type") // Company | Instrument | Index | ...
  instrumentId String?  @map("instrument_id") // logical FK to data-service InstrumentMaster
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  mentions NewsEntityMention[]

  @@unique([surfaceForm, entityType])
  @@map("news_entities")
}

// =============================================================================
// 8. news_entity_mentions
// Per-article record of every named entity extracted (resolved or unresolved).
// =============================================================================
model NewsEntityMention {
  id          String   @id @default(uuid()) @db.Uuid
  articleId   String   @map("article_id") @db.Uuid
  entityId    String?  @map("entity_id") @db.Uuid // null when unresolved
  surfaceForm String   @map("surface_form")
  entityType  String   @map("entity_type")
  confidence  Decimal  @db.Decimal(4, 2)
  sentencePos Int      @map("sentence_pos") // non-negative
  charOffset  Int      @map("char_offset") // non-negative
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  article NewsArticle @relation(fields: [articleId], references: [id])
  entity  NewsEntity? @relation(fields: [entityId], references: [id])

  @@index([articleId])
  @@index([entityId, confidence])
  @@map("news_entity_mentions")
}

// =============================================================================
// 9. news_asset_links
// Resolved article → tradeable instrument mapping (confidence >= 0.50 only).
// =============================================================================
model NewsAssetLink {
  articleId   String   @map("article_id") @db.Uuid
  assetId     String   @map("asset_id") // instrument_id from InstrumentMaster
  confidence  Decimal  @db.Decimal(4, 2)
  publishedAt DateTime @map("published_at") @db.Timestamptz // denormalised for index perf

  // Relations
  article NewsArticle @relation(fields: [articleId], references: [id])

  @@id([articleId, assetId])
  @@index([assetId, publishedAt(sort: Desc)])
  @@map("news_asset_links")
}

// =============================================================================
// 10. news_sector_links
// Resolved article → sector mapping (confidence >= 0.50 only).
// =============================================================================
model NewsSectorLink {
  articleId   String   @map("article_id") @db.Uuid
  sectorId    String   @map("sector_id")
  confidence  Decimal  @db.Decimal(4, 2)
  publishedAt DateTime @map("published_at") @db.Timestamptz // denormalised for index perf

  // Relations
  article NewsArticle @relation(fields: [articleId], references: [id])

  @@id([articleId, sectorId])
  @@index([sectorId, publishedAt(sort: Desc)])
  @@map("news_sector_links")
}

// =============================================================================
// 11. news_event_relationships
// Cross-market relationship graph — used by MarketImpactEngine.
// Only used when confidence >= 0.2 AND sample_size >= 30 AND low_sample = false.
// =============================================================================
model NewsEventRelationship {
  id                    String   @id @default(uuid()) @db.Uuid
  sourceEntityId        String   @map("source_entity_id")
  targetEntityId        String   @map("target_entity_id")
  relationshipType      String   @map("relationship_type") // POSITIVE_CORRELATION | ...
  chainOrder            Int      @default(1) @map("chain_order") // 1-3
  historicalCorrelation Float    @map("historical_correlation")
  confidence            Float
  regimeDependency      String[] @map("regime_dependency") // MarketRegime values
  sampleSize            Int      @default(0) @map("sample_size")
  lowSample             Boolean  @default(false) @map("low_sample")
  lastUpdated           DateTime @default(now()) @map("last_updated") @db.Timestamptz
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  marketImpacts NewsMarketImpact[]

  @@unique([sourceEntityId, targetEntityId, relationshipType])
  @@index([sourceEntityId, confidence])
  @@map("news_event_relationships")
}

// =============================================================================
// 12. news_sentiment
// Multi-dimensional sentiment scores per article × model version.
// New model version → new row (preserves prior scores, Req 8.5).
// =============================================================================
model NewsSentiment {
  id                 String   @id @default(uuid()) @db.Uuid
  articleId          String   @map("article_id") @db.Uuid
  eventId            String?  @map("event_id") @db.Uuid
  sentimentScore     Decimal  @map("sentiment_score") @db.Decimal(6, 4) // -1 to +1
  marketSentiment    Decimal  @map("market_sentiment") @db.Decimal(6, 4)
  companySentiment   Decimal  @map("company_sentiment") @db.Decimal(6, 4)
  macroSentiment     Decimal  @map("macro_sentiment") @db.Decimal(6, 4)
  riskSentiment      Decimal  @map("risk_sentiment") @db.Decimal(6, 4)
  qualitativeSignals String[] @map("qualitative_signals")
  confidence         Decimal  @db.Decimal(4, 2)
  modelVersion       String   @map("model_version")
  computedAt         DateTime @default(now()) @map("computed_at") @db.Timestamptz

  // Relations
  article NewsArticle @relation(fields: [articleId], references: [id])
  event   NewsEvent?  @relation(fields: [eventId], references: [id])

  @@unique([articleId, modelVersion])
  @@index([articleId])
  @@map("news_sentiment")
}

// =============================================================================
// 13. news_importance
// Importance score for each NewsEvent with full sub-score audit trail.
// =============================================================================
model NewsImportance {
  id                      String   @id @default(uuid()) @db.Uuid
  eventId                 String   @unique @map("event_id") @db.Uuid
  importanceScore         Float    @map("importance_score")
  subScores               Json     @map("sub_scores") // JSONB
  historicalDataAvailable Boolean  @default(false) @map("historical_data_available")
  modelVersion            String   @map("model_version")
  computedAt              DateTime @default(now()) @map("computed_at") @db.Timestamptz

  // Relations
  event NewsEvent @relation(fields: [eventId], references: [id])

  @@index([importanceScore(sort: Desc), computedAt(sort: Desc)])
  @@map("news_importance")
}

// =============================================================================
// 14. news_market_impacts
// Directional impact prediction per (event, asset/sector) pair.
// Idempotency key: (event_id, asset_id)
// =============================================================================
model NewsMarketImpact {
  id                       String   @id @default(uuid()) @db.Uuid
  articleId                String   @map("article_id") @db.Uuid
  eventId                  String   @map("event_id") @db.Uuid
  assetId                  String?  @map("asset_id")
  sectorId                 String?  @map("sector_id")
  direction                String // POSITIVE | NEGATIVE | NEUTRAL | UNCERTAIN
  strength                 Float
  confidence               Float
  expectedHorizon          String   @map("expected_horizon") // IMMEDIATE | INTRADAY | SHORT_TERM | SWING | LONG_TERM
  evidenceType             String   @map("evidence_type") // HISTORICAL | RULE_BASED | MODEL
  relationshipId           String?  @map("relationship_id") @db.Uuid
  newsImpactScore          Float?   @map("news_impact_score") // -100 to +100
  impactComponents         Json?    @map("impact_components") // JSONB — each multiplicative factor
  impactComputationVersion String   @map("impact_computation_version")
  computedAt               DateTime @default(now()) @map("computed_at") @db.Timestamptz

  // Relations
  article      NewsArticle            @relation(fields: [articleId], references: [id])
  event        NewsEvent              @relation(fields: [eventId], references: [id])
  relationship NewsEventRelationship? @relation(fields: [relationshipId], references: [id])

  @@unique([eventId, assetId])
  @@index([assetId, computedAt(sort: Desc)])
  @@map("news_market_impacts")
}

// =============================================================================
// 15. news_market_reactions
// Observed price/volume/volatility changes following past events.
// =============================================================================
model NewsMarketReaction {
  id                         String    @id @default(uuid()) @db.Uuid
  eventId                    String    @map("event_id") @db.Uuid
  assetId                    String    @map("asset_id")
  return1m                   Float?    @map("return_1m")
  return5m                   Float?    @map("return_5m")
  return15m                  Float?    @map("return_15m")
  return30m                  Float?    @map("return_30m")
  return1h                   Float?    @map("return_1h")
  return4h                   Float?    @map("return_4h")
  return1d                   Float?    @map("return_1d")
  volumeChangeRatio          Float?    @map("volume_change_ratio")
  volatilityChangeRatio      Float?    @map("volatility_change_ratio")
  highImpactFlag             Boolean   @default(false) @map("high_impact_flag")
  marketOpen                 Boolean   @default(true) @map("market_open")
  dataServiceTimeout         Boolean   @default(false) @map("data_service_timeout")
  dataServiceSnapshotVersion String?   @map("data_service_snapshot_version")
  /// Phase 3B.1: start of the earliest query window (event_timestamp - 15m).
  reactionWindowStart        DateTime? @map("reaction_window_start") @db.Timestamptz
  /// Phase 3B.1: end of the latest query window (event_timestamp + 1d).
  reactionWindowEnd          DateTime? @map("reaction_window_end") @db.Timestamptz
  computedAt                 DateTime  @default(now()) @map("computed_at") @db.Timestamptz

  // Relations
  event NewsEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, assetId])
  @@index([eventId])
  @@index([assetId, computedAt(sort: Desc)])
  @@map("news_market_reactions")
}

// =============================================================================
// 16. news_market_regimes
// Current and historical discrete market environment classifications.
// valid_to = null → current active regime.
// =============================================================================
model NewsMarketRegime {
  id         String    @id @default(uuid()) @db.Uuid
  marketId   String    @map("market_id") // "india" | "us" | "global"
  regime     String // TRENDING_BULL | HIGH_VOLATILITY | RISK_OFF | ...
  confidence Float
  validFrom  DateTime  @map("valid_from") @db.Timestamptz
  validTo    DateTime? @map("valid_to") @db.Timestamptz

  @@index([marketId, validTo(sort: Asc)])
  @@map("news_market_regimes")
}

// =============================================================================
// 17. news_features
// Point-in-time correct numerical feature vectors for ml-service.
// Idempotency key: (event_id, asset_id, feature_version)
// =============================================================================
model NewsFeature {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String?   @map("event_id") @db.Uuid
  assetId         String?   @map("asset_id")
  entityType      String?   @map("entity_type") // "article" | "VELOCITY" | "BREADTH" | ...
  entityId        String?   @map("entity_id")
  featureType     String    @map("feature_type")
  featureVector   Json?     @map("feature_vector") // JSONB
  window          String?   // "1m" | "5m" (for velocity)
  value           Float?
  baseline        Float?
  momentum        Float?
  featureVersion  String    @map("feature_version")
  pipelineVersion String    @map("pipeline_version")
  /// Phase 3B.1 (Gap PT-G2): the latest information timestamp across all data
  /// sources contributing to this feature vector.
  ///   - Text-derived features: article.published_at
  ///   - Market-data features:  bar.timestamp (bar open time)
  /// MUST be <= prediction_timestamp.
  /// Distinct from computed_at (wall-clock when engine ran) — see TEMPORAL_DATA_CONTRACT.md.
  featureAsOf     DateTime? @map("feature_as_of") @db.Timestamptz
  computedAt      DateTime  @default(now()) @map("computed_at") @db.Timestamptz

  // Relations
  event           NewsEvent?           @relation(fields: [eventId], references: [id])
  // NOTE: entity_id is TEXT (not UUID) so it cannot be a typed Prisma relation
  // to NewsArticle (which has UUID PK). Application-layer enforcement only.
  trainingSamples NewsTrainingSample[]

  @@unique([eventId, assetId, featureVersion])
  @@index([eventId])
  @@index([assetId, computedAt(sort: Desc)])
  @@index([featureType, entityId, computedAt(sort: Desc)])
  @@index([featureAsOf(sort: Desc)])
  @@map("news_features")
}

// =============================================================================
// 18. news_embeddings
// Semantic embedding vectors for articles, events, and entities (pgvector).
// HNSW index is created in migration SQL using vector_cosine_ops (Req 18.2).
// =============================================================================
model NewsEmbedding {
  id           String                       @id @default(uuid()) @db.Uuid
  entityType   String                       @map("entity_type") // "article" | "event" | "entity"
  entityId     String                       @map("entity_id")
  embedding    Unsupported("vector(1536)")?
  modelVersion String                       @map("model_version")
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId, modelVersion])
  @@map("news_embeddings")
}

// =============================================================================
// 19. news_training_samples
// Labelled feature vectors for ml-service model training.
// label_Xm values: STRONG_BULLISH | BULLISH | NEUTRAL | BEARISH | STRONG_BEARISH
// =============================================================================
model NewsTrainingSample {
  id                        String    @id @default(uuid()) @db.Uuid
  eventId                   String    @map("event_id") @db.Uuid
  assetId                   String    @map("asset_id")
  articleIds                String[]  @map("article_ids")
  featureVectorId           String    @map("feature_vector_id") @db.Uuid
  /// Phase 3B.1 (Gap PT-G3): the moment at which AlphaForge generates a signal.
  /// Initial training policy: prediction_timestamp = event_timestamp.
  /// INVARIANT: feature_as_of <= prediction_timestamp < label_cutoff_X.
  predictionTimestamp       DateTime? @map("prediction_timestamp") @db.Timestamptz
  futureReturn5m            Float?    @map("future_return_5m")
  futureReturn15m           Float?    @map("future_return_15m")
  futureReturn30m           Float?    @map("future_return_30m")
  futureReturn1h            Float?    @map("future_return_1h")
  futureReturn4h            Float?    @map("future_return_4h")
  futureReturn1d            Float?    @map("future_return_1d")
  label5m                   String?   @map("label_5m")
  label15m                  String?   @map("label_15m")
  label30m                  String?   @map("label_30m")
  label1h                   String?   @map("label_1h")
  label4h                   String?   @map("label_4h")
  label1d                   String?   @map("label_1d")
  labelCutoff5m             DateTime? @map("label_cutoff_5m") @db.Timestamptz
  labelCutoff15m            DateTime? @map("label_cutoff_15m") @db.Timestamptz
  labelCutoff30m            DateTime? @map("label_cutoff_30m") @db.Timestamptz
  labelCutoff1h             DateTime? @map("label_cutoff_1h") @db.Timestamptz
  labelCutoff4h             DateTime? @map("label_cutoff_4h") @db.Timestamptz
  labelCutoff1d             DateTime? @map("label_cutoff_1d") @db.Timestamptz
  /// Phase 3B.1 (Gap PT-G5): exact bar timestamps used to compute each label.
  /// INVARIANT: label_bar_timestamp_Xm <= label_cutoff_Xm
  labelBarTimestamp5m       DateTime? @map("label_bar_timestamp_5m") @db.Timestamptz
  labelBarTimestamp15m      DateTime? @map("label_bar_timestamp_15m") @db.Timestamptz
  labelBarTimestamp30m      DateTime? @map("label_bar_timestamp_30m") @db.Timestamptz
  labelBarTimestamp1h       DateTime? @map("label_bar_timestamp_1h") @db.Timestamptz
  labelBarTimestamp4h       DateTime? @map("label_bar_timestamp_4h") @db.Timestamptz
  labelBarTimestamp1d       DateTime? @map("label_bar_timestamp_1d") @db.Timestamptz
  featureVersion            String    @map("feature_version")
  pipelineVersion           String    @map("pipeline_version")
  marketDataSnapshotVersion String    @map("market_data_snapshot_version")
  modelVersion              String    @map("model_version")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// PIT validation flag (mandate S10, S14).
  /// True when predictionTimestamp is set AND article published_at <= predictionTimestamp
  /// AND no future-dated features were used. ml-service2.0 rejects samples where false.
  lookAheadValidated        Boolean   @default(false) @map("look_ahead_validated")
  /// UTC published_at of the article used as PIT anchor. Must be <= predictionTimestamp.
  pitAnchorPublishedAt      DateTime? @map("pit_anchor_published_at") @db.Timestamptz

  // Relations
  event         NewsEvent   @relation(fields: [eventId], references: [id])
  featureVector NewsFeature @relation(fields: [featureVectorId], references: [id])

  @@unique([eventId, assetId, predictionTimestamp, featureVersion], name: "uq_training_sample_identity")
  @@index([eventId, assetId, featureVersion])
  @@index([assetId, createdAt(sort: Desc)])
  @@index([predictionTimestamp(sort: Desc)])
  @@map("news_training_samples")
}

// =============================================================================
// 20. news_source_metrics
// Rolling window performance metrics per source (latency, fetch counts).
// =============================================================================
model NewsSourceMetric {
  id              String   @id @default(uuid()) @db.Uuid
  sourceId        String   @map("source_id")
  windowStart     DateTime @map("window_start") @db.Timestamptz
  windowEnd       DateTime @map("window_end") @db.Timestamptz
  articlesFetched Int      @default(0) @map("articles_fetched")
  articlesFailed  Int      @default(0) @map("articles_failed")
  avgLatencyMs    Float?   @map("avg_latency_ms")
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  // Relations
  source NewsSource @relation(fields: [sourceId], references: [id])

  @@index([sourceId, windowStart(sort: Desc)])
  @@map("news_source_metrics")
}

// =============================================================================
// 21. news_ingestion_runs
// One record per scheduled ingestion run per source (Req 2.8).
// status: "success" | "partial_failure" | "failed"
// =============================================================================
model NewsIngestionRun {
  id              String    @id @default(uuid()) @db.Uuid
  sourceId        String    @map("source_id")
  startedAt       DateTime  @map("started_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  articlesFetched Int       @default(0) @map("articles_fetched")
  articlesFailed  Int       @default(0) @map("articles_failed")
  status          String // success | partial_failure | failed

  // Relations
  source NewsSource @relation(fields: [sourceId], references: [id])

  @@index([sourceId, startedAt(sort: Desc)])
  @@map("news_ingestion_runs")
}

// =============================================================================
// 22. news_processing_errors
// Error records for all pipeline stages (normalization, dedup, entity, …).
// =============================================================================
model NewsProcessingError {
  id           String   @id @default(uuid()) @db.Uuid
  sourceId     String?  @map("source_id")
  externalId   String?  @map("external_id")
  stage        String // normalization | deduplication | entity | ...
  errorType    String   @map("error_type")
  errorMessage String   @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  source NewsSource? @relation(fields: [sourceId], references: [id])

  @@index([stage, createdAt(sort: Desc)])
  @@map("news_processing_errors")
}

// =============================================================================
// 23. news_alerts
// High-importance event alerts delivered to subscribed channels.
// =============================================================================
model NewsAlert {
  id               String   @id @default(uuid()) @db.Uuid
  alertType        String   @map("alert_type")
  triggerReason    String   @map("trigger_reason")
  assetId          String   @map("asset_id")
  eventId          String?  @map("event_id") @db.Uuid
  clusterId        String?  @map("cluster_id") @db.Uuid
  importanceScore  Float    @map("importance_score")
  description      String // max 500 chars (enforced at app layer)
  payload          Json // JSONB
  deliveryChannels Json     @map("delivery_channels") // JSONB — per-channel delivery_status
  computedAt       DateTime @default(now()) @map("computed_at") @db.Timestamptz

  // Relations
  event   NewsEvent?   @relation(fields: [eventId], references: [id])
  cluster NewsCluster? @relation(fields: [clusterId], references: [id])

  @@index([assetId, computedAt(sort: Desc)])
  @@index([clusterId, alertType, computedAt(sort: Desc)])
  @@map("news_alerts")
}
