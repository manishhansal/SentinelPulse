{
  "name": "sentinel-pulse",
  "version": "1.0.0",
  "description": "Production-grade market intelligence and news impact engine for AlphaForge",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@prisma/client": "5.22.0",
    "axios": "1.18.0",
    "bullmq": "5.34.5",
    "fast-check": "3.23.2",
    "fastify": "5.12.1",
    "franc-min": "6.2.0",
    "ioredis": "5.4.2",
    "natural": "8.0.1",
    "openai": "4.83.0",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "prom-client": "15.1.3",
    "uuid": "14.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.24.1",
    "@typescript-eslint/parser": "8.24.1",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.20.1",
    "prettier": "3.5.1",
    "prisma": "5.22.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
