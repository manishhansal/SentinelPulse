# Version control
.git
.gitignore
.gitattributes

# Dependencies — rebuilt inside the image
node_modules
dist

# Environment files — never bake secrets into images
.env
.env.local
.env.production
.env.staging
.env.*.local

# Tests and CI tooling — not needed at runtime
tests/
coverage/
.nyc_output/
*.lcov
.github/
.husky/

# Documentation — reduces image size
docs/
*.md
!prisma/README.md

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Logs
logs/
*.log
npm-debug.log*

# TypeScript build info
*.tsbuildinfo

# Docker Compose orchestration files
docker-compose.override.yml
docker-compose.local.yml

# Tmp
tmp/
temp/
.cache/
