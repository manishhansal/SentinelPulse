# SentinelPulse — Environment Template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
#
# Phase 3A verified configuration — 2026-09-15

# ─── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL: use data-service-postgres (port 5444) in local dev stack
DATABASE_URL=postgresql://sentinel:CHANGE_ME@localhost:5444/sentinel_pulse
REDIS_URL=redis://localhost:6379
SENTINEL_API_KEY=CHANGE_ME
# data-service: AlphaForge data-service, running on port 8200 in local dev
DATA_SERVICE_URL=http://localhost:8200
DATA_SERVICE_API_KEY=CHANGE_ME
SCRAPLING_URL=http://localhost:8001
# ml-service: for regime prediction (POST /predict/regime)
ML_SERVICE_URL=http://localhost:8100

# ─── Feature / Pipeline versioning (semver MAJOR.MINOR.PATCH required) ─────────
FEATURE_VERSION=1.0.0
PIPELINE_VERSION=1.0.0

# ─── Source toggles ─────────────────────────────────────────────────────────────
NEWS_SOURCE_REUTERS_ENABLED=true
NEWS_SOURCE_MONEYCONTROL_ENABLED=true
NEWS_SOURCE_ECONOMICTIMES_ENABLED=true
NEWS_SOURCE_BLOOMBERG_ENABLED=false
NEWS_SOURCE_FINANCIALTIMES_ENABLED=false
NEWS_SOURCE_COINDESK_ENABLED=false

# ─── Per-source config ──────────────────────────────────────────────────────────
# IMPORTANT: These must point to RSS feed URLs, NOT homepage URLs.
# Homepage URLs cause health check failures (maxContentLength exceeded).

NEWS_SOURCE_REUTERS_BASE_URL=https://news.google.com/rss/search?q=site:reuters.com+finance+markets&hl=en-IN&gl=IN&ceid=IN:en
NEWS_SOURCE_REUTERS_POLL_INTERVAL_MS=60000

# Correct RSS feed URL (NOT https://www.moneycontrol.com)
NEWS_SOURCE_MONEYCONTROL_BASE_URL=https://www.moneycontrol.com/rss/MCtopnews.xml
NEWS_SOURCE_MONEYCONTROL_POLL_INTERVAL_MS=60000

# Correct RSS feed URL (NOT https://economictimes.indiatimes.com)
NEWS_SOURCE_ECONOMICTIMES_BASE_URL=https://economictimes.indiatimes.com/rssfeedsdefault.cms
NEWS_SOURCE_ECONOMICTIMES_POLL_INTERVAL_MS=60000

NEWS_SOURCE_BLOOMBERG_BASE_URL=https://www.bloomberg.com
NEWS_SOURCE_BLOOMBERG_POLL_INTERVAL_MS=120000
NEWS_SOURCE_BLOOMBERG_API_KEY=

NEWS_SOURCE_FINANCIALTIMES_BASE_URL=https://www.ft.com
NEWS_SOURCE_FINANCIALTIMES_POLL_INTERVAL_MS=120000
NEWS_SOURCE_FINANCIALTIMES_API_KEY=

# Correct RSS feed URL (NOT https://www.coindesk.com)
NEWS_SOURCE_COINDESK_BASE_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
NEWS_SOURCE_COINDESK_POLL_INTERVAL_MS=300000

# ─── Circuit breaker defaults ───────────────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_MS=60000

# ─── Retry config ───────────────────────────────────────────────────────────────
RETRY_BASE_DELAY_MS=1000
RETRY_MULTIPLIER=2
RETRY_MAX_ATTEMPTS=3

# ─── Worker concurrency ─────────────────────────────────────────────────────────
WORKER_NORMALIZE_CONCURRENCY=4
WORKER_DEDUP_CONCURRENCY=2
WORKER_ENTITY_CONCURRENCY=4
WORKER_EVENT_CONCURRENCY=4
WORKER_SENTIMENT_CONCURRENCY=4
WORKER_IMPACT_CONCURRENCY=2
WORKER_FEATURE_CONCURRENCY=4
WORKER_EMBED_CONCURRENCY=2

# ─── Backfill ───────────────────────────────────────────────────────────────────
BACKFILL_MAX_CONCURRENCY=2
BACKFILL_MAX_LIVE_QUEUE_SHARE=0.20

# ─── Embedding ──────────────────────────────────────────────────────────────────
# OPTIONAL: If absent, embedding stage is SKIPPED (non-blocking).
# Core pipeline (event/sentiment/importance/features) works without this key.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=

# ─── SSRF allowlist ──────────────────────────────────────────────────────────────
# Must include www. variants — the SSRF guard also supports parent domain matching.
ALLOWED_SOURCE_DOMAINS=news.google.com,feeds.reuters.com,moneycontrol.com,www.moneycontrol.com,economictimes.indiatimes.com,www.economictimes.indiatimes.com,bloomberg.com,www.bloomberg.com,ft.com,www.ft.com,coindesk.com,www.coindesk.com,localhost

# ─── Staleness protection thresholds (Phase 3A) ─────────────────────────────────
# Seconds before FRESH→STALE transition
FRESHNESS_FRESH_THRESHOLD_SECONDS=300
# Seconds before STALE→EXPIRED transition (expired data must not reach AlphaForge)
FRESHNESS_STALE_THRESHOLD_SECONDS=3600

# ─── Data retention (days; 0 = indefinite) ──────────────────────────────────────
RETENTION_RAW_ARTICLES_DAYS=90
RETENTION_NORMALIZED_ARTICLES_DAYS=365
RETENTION_EVENTS_DAYS=730
RETENTION_TRAINING_SAMPLES_DAYS=0

# ─── Node environment ───────────────────────────────────────────────────────────
NODE_ENV=development
# LOCAL DEV: Use 3001 — AlphaForge occupies port 3000
PORT=3001
LOG_LEVEL=info
